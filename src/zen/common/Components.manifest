# Custom Browser: first, so everything after it sees settings under their current names.
category browser-before-ui-startup chrome://browser/content/zen-components/CustomMigration.sys.mjs CustomMigration.run
category browser-before-ui-startup resource:///modules/ZenActorsManager.sys.mjs gZenActorsManager.init
category browser-before-ui-startup resource:///modules/zen/boosts/ZenBoostsManager.sys.mjs gZenBoostsManager.init

category browser-window-delayed-startup resource:///modules/zen/ui/ZenProgressBar.sys.mjs ZenProgressBar.create

#ifdef MOZ_PROFILE_GENERATE
category browser-window-delayed-startup resource:///modules/ZenPGOTraining.sys.mjs ZenPGOTraining.onWindowReady
#endif
