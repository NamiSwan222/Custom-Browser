# Settings > Look and Feel > Personalize

jessnix-personalize-title = Personalize

jessnix-personalize-name-header = Browser name
jessnix-personalize-name-description = The name shown in the window title and on the taskbar. Leave it empty to use { -brand-short-name }.
jessnix-personalize-name-input =
    .placeholder = { -brand-full-name }
    .aria-label = Browser name

jessnix-personalize-icon-header = App icon
jessnix-personalize-icon-description = The icon on each window and its taskbar button. A square PNG of at least 256 × 256 pixels looks sharpest. A pinned taskbar shortcut keeps its own icon.

jessnix-personalize-background-header = Background
jessnix-personalize-background-description = An image behind your tabs and toolbars. Your space’s colors show through it.
jessnix-personalize-background-strength = Image strength
jessnix-personalize-strength-subtle =
    .label = Subtle
jessnix-personalize-strength-balanced =
    .label = Balanced
jessnix-personalize-strength-strong =
    .label = Strong

jessnix-personalize-colors-header = Colors
jessnix-personalize-colors-description = The accent color is used for buttons and highlights. To change a space’s colors, right-click the space in the sidebar and choose Theme…
jessnix-personalize-accent-label = Accent color
jessnix-personalize-accent-system =
    .label = Use Windows accent color

jessnix-personalize-choose-image =
    .label = Choose image…
jessnix-personalize-use-default =
    .label = Use default
jessnix-personalize-remove-image =
    .label = Remove image
jessnix-personalize-reset =
    .label = Reset

jessnix-personalize-pick-icon = Choose an icon
jessnix-personalize-pick-background = Choose a background image

jessnix-personalize-error-type = That file isn’t an image { -brand-short-name } can use. Choose a PNG, JPEG, WebP, GIF, BMP or ICO file.
jessnix-personalize-error-size = That image is larger than { $megabytes } MB. Choose a smaller one.
